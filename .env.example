# Veritabanı
DATABASE_URL=postgresql+psycopg2://iha:iha@localhost:5432/iha_filo

# Celery + RabbitMQ
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=rpc://
CELERY_TASK_QUEUE=telemetry

# Toplu telemetri yüklemesi
UPLOAD_DIR=/app/uploads
CSV_CHUNK_SIZE=5000

# JWT — üretimde MUTLAKA değiştirilmeli
SECRET_KEY=degistir-beni-cok-gizli-anahtar
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
